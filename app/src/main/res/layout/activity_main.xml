<?xml version="1.0" encoding="utf-8"?>
<!-- The page fills the screen; the top bar (added in code) and the player float over it and slide away while you read. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbarStyle="outsideOverlay">

        <com.bernardo.ereader.PageView
            android:id="@+id/page"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:breakStrategy="high_quality"
            android:hyphenationFrequency="normal"
            android:paddingHorizontal="24dp"
            android:paddingTop="88dp"
            android:paddingBottom="140dp"
            android:textIsSelectable="true" />
    </ScrollView>

    <!-- shown instead of the page when no book is open -->
    <FrameLayout
        android:id="@+id/emptyHolder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="24dp"
        android:visibility="gone" />

    <!-- bottom dock: small notices above the player, then the player; slides down as one -->
    <LinearLayout
        android:id="@+id/dock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- appears only if preparing the voice takes more than a moment -->
        <TextView
            android:id="@+id/bufferPill"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginBottom="10dp"
            android:elevation="4dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- shown while narrating if you scrolled away: back to the sentence being read -->
        <TextView
            android:id="@+id/jumpBack"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginBottom="12dp"
            android:elevation="6dp"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="18dp"
            android:text="Back to the voice"
            android:textSize="14sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="4dp">

                <!-- shrinks a little before it cuts the minutes left off -->
                <TextView
                    android:id="@+id/pageLabel"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:autoSizeMaxTextSize="13sp"
                    android:autoSizeMinTextSize="11sp"
                    android:autoSizeStepGranularity="0.5sp"
                    android:autoSizeTextType="uniform"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/audioChip"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:text="Pre-load"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/speedChip"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:gravity="center"
                    android:maxLines="1"
                    android:minWidth="56dp"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/prev"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="Previous chapter"
                    android:src="@drawable/ic_chevron_left" />

                <ImageButton
                    android:id="@+id/back"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="12dp"
                    android:contentDescription="Previous sentence"
                    android:src="@drawable/ic_skip_prev" />

                <FrameLayout
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginHorizontal="18dp">

                    <ImageButton
                        android:id="@+id/play"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_gravity="center"
                        android:contentDescription="Read aloud"
                        android:elevation="2dp"
                        android:src="@drawable/ic_play" />

                    <ProgressBar
                        android:id="@+id/busy"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:elevation="3dp"
                        android:importantForAccessibility="no"
                        android:indeterminate="true"
                        android:visibility="gone" />
                </FrameLayout>

                <ImageButton
                    android:id="@+id/fwd"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="12dp"
                    android:contentDescription="Next sentence"
                    android:src="@drawable/ic_skip_next" />

                <ImageButton
                    android:id="@+id/next"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="Next chapter"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
